@model ReceitaFormViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Nova receita";
    var camel = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var ingredientesJson = JsonSerializer.Serialize((object)ViewBag.Ingredientes);
    var unidades = new[]
    {
        new { v = 1, t = "g", tipo = "massa" },
        new { v = 2, t = "kg", tipo = "massa" },
        new { v = 3, t = "ml", tipo = "volume" },
        new { v = 4, t = "L", tipo = "volume" }
    };
    var unidadesJson = JsonSerializer.Serialize(unidades);
    var inicialJson = JsonSerializer.Serialize(Model.Etapas, camel);
    var semIngredientes = ((System.Collections.IEnumerable)ViewBag.Ingredientes).Cast<object>().Count() == 0;
}

<a asp-action="Index" class="small">Voltar para as receitas</a>
<h1 class="h3 mt-1 mb-4">Nova receita</h1>

@if (semIngredientes)
{
    <div class="panel">
        <p class="mb-2"><strong>Cadastre ao menos um ingrediente antes.</strong></p>
        <a class="btn btn-success" asp-controller="Ingredientes" asp-action="Create">Adicionar ingrediente</a>
    </div>
}
else
{
    <form id="form-receita" asp-action="Create" method="post">
        <div asp-validation-summary="All" class="alert alert-danger" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

        <div class="panel mb-4">
            <div class="mb-3">
                <label class="form-label" asp-for="Nome">Nome do prato</label>
                <input class="form-control" asp-for="Nome" maxlength="120" required />
            </div>
            <div>
                <label class="form-label" asp-for="Descricao">Descrição (opcional)</label>
                <input class="form-control" asp-for="Descricao" maxlength="500" />
            </div>
        </div>

        <h2 class="h5">Etapas</h2>
        <p class="text-muted small">Em cada etapa, informe os ingredientes que ela usa. Se o preparo for cancelado, os ingredientes das etapas que ainda não começaram voltam ao estoque.</p>

        <div id="etapas"
             data-ingredientes="@ingredientesJson"
             data-unidades="@unidadesJson"
             data-inicial="@inicialJson"></div>

        <div class="d-flex gap-2 mb-4">
            <button type="button" id="add-etapa" class="btn btn-outline-primary">Adicionar etapa</button>
        </div>

        <button class="btn btn-primary">Salvar receita</button>
    </form>
}

@section Scripts {
    <script src="~/js/receita-form.js" asp-append-version="true"></script>
}
